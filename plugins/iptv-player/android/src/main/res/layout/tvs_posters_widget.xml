<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tvs_widget_bg">

    <AdapterViewFlipper
        android:id="@+id/tvs_p_flip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="6000"
        android:inAnimation="@android:animator/fade_in"
        android:outAnimation="@android:animator/fade_out"
        android:loopViews="true" />

    <TextView
        android:id="@+id/tvs_p_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="14dp"
        android:text="Pas de grosse affiche pour l’instant.\nOuvre le hub Sport de TV Streamy pour mettre à jour."
        android:textColor="#CCFFFFFF"
        android:textSize="13sp" />
</FrameLayout>
