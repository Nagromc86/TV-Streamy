<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/tvs_widget_bg" android:orientation="vertical" android:padding="8dp">
    <TextView android:id="@+id/tvs_l_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="6dp" android:paddingBottom="4dp" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/tvs_l_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="#22FFFFFF" android:dividerHeight="1dp" />
        <TextView android:id="@+id/tvs_l_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="10dp" android:textColor="#B3FFFFFF" android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
