<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <queries>
        <package android:name="com.samsung.android.smartmirroring" />
        <intent>
            <action android:name="com.samsung.android.smartmirroring.CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.settings.CAST_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_DISPLAY_SETTINGS" />
        </intent>
    </queries>
    <application>
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="fr.nagromc86.iptvplayer.CastOptionsProvider" />
        <service
            android:name="fr.nagromc86.iptvplayer.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="fr.nagromc86.iptvplayer.AudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="fr.nagromc86.iptvplayer.CastService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name="fr.nagromc86.iptvplayer.PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <activity
            android:name="fr.nagromc86.iptvplayer.ResumeLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver
            android:name="fr.nagromc86.iptvplayer.ResumeWidget"
            android:exported="true"
            android:label="@string/tvs_resume_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_resume_widget_info" />
        </receiver>
        <activity
            android:name="fr.nagromc86.iptvplayer.ChannelLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="fr.nagromc86.iptvplayer.ChannelConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver
            android:name="fr.nagromc86.iptvplayer.ChannelWidget"
            android:exported="true"
            android:label="@string/tvs_channel_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_channel_widget_info" />
        </receiver>
        <activity
            android:name="fr.nagromc86.iptvplayer.PosterLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="fr.nagromc86.iptvplayer.PostersService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver
            android:name="fr.nagromc86.iptvplayer.PostersWidget"
            android:exported="true"
            android:label="@string/tvs_posters_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_posters_widget_info" />
        </receiver>
        <receiver
            android:name="fr.nagromc86.iptvplayer.AccountsWidget"
            android:exported="true"
            android:label="@string/tvs_accounts_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_accounts_widget_info" />
        </receiver>
        <activity
            android:name="fr.nagromc86.iptvplayer.OpenItemActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="fr.nagromc86.iptvplayer.ListWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver
            android:name="fr.nagromc86.iptvplayer.TonightWidget"
            android:exported="true"
            android:label="@string/tvs_tonight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_tonight_widget_info" />
        </receiver>
        <receiver
            android:name="fr.nagromc86.iptvplayer.NewEpisodesWidget"
            android:exported="true"
            android:label="@string/tvs_neweps_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_neweps_widget_info" />
        </receiver>
        <receiver
            android:name="fr.nagromc86.iptvplayer.MyListWidget"
            android:exported="true"
            android:label="@string/tvs_mylist_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_mylist_widget_info" />
        </receiver>
        <receiver
            android:name="fr.nagromc86.iptvplayer.DownloadsWidget"
            android:exported="true"
            android:label="@string/tvs_downloads_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tvs_downloads_widget_info" />
        </receiver>
    </application>
</manifest>
